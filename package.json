{
  "name": "koyofes-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mirror-cms-images.mjs && next build",
    "cms:mirror-images": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mirror-cms-images.mjs",
    "test:cms-images": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/mirror-cms-images.test.mjs",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "secretlint": "secretlint --maskSecrets --secretlintignore .gitignore \"**/*\"",
    "lint:html": "markuplint \"./{app,components}/**/*.{ts,tsx}\"",
    "lint:html:fix": "markuplint \"./{app,components}/**/*.{ts,tsx}\" --fix",
    "prettier": "prettier --write .",
    "stamp:generate-tokens": "node scripts/generate-stamp-tokens.mjs",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "html-react-parser": "^6.1.2",
    "lucide-react": "^0.564.0",
    "next": "16.2.6",
    "postgres": "^3.4.9",
    "react": "^19",
    "react-dom": "^19",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@markuplint/jsx-parser": "^4.18.3",
    "@markuplint/react-spec": "^4.18.0",
    "@next/eslint-plugin-next": "^16.2.10",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "markuplint": "^4.18.3",
    "postcss": "^8.5",
    "prettier": "^3.9.5",
    "secretlint": "^13.0.2",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.64.0"
  }
}
